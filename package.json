{
    "name":  "seal3d",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "description":  "浏览器端 3D 可打印印章生成器（FDM 优先）",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "check:mirror":  "node _probe/mirror-check.mjs",
                    "check:e2e":  "node --experimental-strip-types scripts/e2e-m1-check.ts",
                    "check:geometry":  "node --experimental-strip-types scripts/geometry-regression.ts"
                },
    "dependencies":  {
                         "@jscadui/3mf-export":  "^0.5.0",
                         "fflate":  "^0.8.3",
                         "manifold-3d":  "^3.5.5",
                         "opentype.js":  "^2.0.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "three":  "^0.187.0",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@types/opentype.js":  "^1.3.10",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@types/three":  "^0.187.0",
                            "@vitejs/plugin-react":  "^6.3.0",
                            "esbuild":  "^0.28.2",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.3.8"
                        }
}