{
  "name": "seal3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器端 3D 可打印印章生成器（FDM 优先）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:verify": "node --experimental-strip-types scripts/verify.ts",
    "check:geometry": "node --experimental-strip-types scripts/geometry-regression.ts",
    "check:sample": "node --experimental-strip-types scripts/build-sample.ts",
    "check:e2e": "node --experimental-strip-types scripts/e2e-m1-check.ts",
    "check:layout": "node --experimental-strip-types scripts/layout-check.ts",
    "build:lab": "vite build --config vite.lab.config.ts",
    "preview:lab": "vite preview --config vite.lab.config.ts --port 4174",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.5",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
